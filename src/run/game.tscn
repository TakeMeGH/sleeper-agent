[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/screen_effects/ability_look.gd" id="20_look"]
[ext_resource type="PackedScene" path="res://src/ui/screen_fade.tscn" id="30_fade"]
[ext_resource type="Script" path="res://src/player/death_collapse.gd" id="31_col"]
[ext_resource type="Script" path="res://src/ui/death_tip.gd" id="32_tip"]
[ext_resource type="Script" path="res://src/run/run_flow.gd" id="33_flow"]
[ext_resource type="Resource" path="res://assets/data/run/death_flow.tres" id="34_flowdata"]
[ext_resource type="Resource" path="res://assets/data/run/tips.tres" id="35_tips"]
[ext_resource type="Script" path="res://src/ui/screen_effects/heart_rate_screen.gd" id="22_hrs"]
[ext_resource type="Resource" path="res://assets/data/heart/heart_rate_screen.tres" id="23_hrsdata"]
[ext_resource type="Resource" path="res://assets/data/player/ability_look.tres" id="21_lookdata"]
[ext_resource type="PackedScene" path="res://src/ui/hud/crosshair.tscn" id="99_cross"]
[ext_resource type="Script" path="res://src/ui/hud/hit_arcs.gd" id="97_arcs"]
[ext_resource type="Script" path="res://src/ui/hud/danger_countdown_label.gd" id="96_cdl"]
[ext_resource type="Resource" path="res://assets/data/ui/hit_arcs.tres" id="95_arcsdata"]
[ext_resource type="Script" path="res://src/run/level_rotation.gd" id="1_rot"]
[ext_resource type="Resource" path="res://assets/data/levels/levels.tres" id="2_levels"]
[ext_resource type="Resource" path="res://assets/data/levels/level_notice.tres" id="3_notice"]
[ext_resource type="PackedScene" path="res://src/player/player.tscn" id="4_player"]
[ext_resource type="PackedScene" path="res://src/ui/hud/hud.tscn" id="5_hud"]
[ext_resource type="Script" path="res://src/run/run_state.gd" id="6_run"]
[ext_resource type="Script" path="res://src/waves/wave_spawner.gd" id="7_spawner"]
[ext_resource type="Resource" path="res://assets/data/waves/default_waves.tres" id="8_waves"]
[ext_resource type="Resource" path="res://assets/data/drops/drops.tres" id="9_drops"]
[ext_resource type="PackedScene" path="res://src/ui/run_end/run_end_screen.tscn" id="10_runend"]

[node name="Game" type="Node3D" node_paths=PackedStringArray("spawner", "player", "run_state", "heart", "level_holder", "screen_fade") groups=["game"]]
script = ExtResource("1_rot")
data = ExtResource("2_levels")
notice_data = ExtResource("3_notice")
spawner = NodePath("WaveSpawner")
player = NodePath("Player")
run_state = NodePath("RunState")
heart = NodePath("Player/HeartRate")
level_holder = NodePath("LevelHolder")
screen_fade = NodePath("ScreenFade")

[node name="LevelHolder" type="Node3D" parent="."]

[node name="Player" parent="." instance=ExtResource("4_player")]

[node name="RunState" type="Node" parent="." node_paths=PackedStringArray("heart", "spawner")]
script = ExtResource("6_run")
heart = NodePath("../Player/HeartRate")
spawner = NodePath("../WaveSpawner")

[node name="WaveSpawner" type="Node" parent="." node_paths=PackedStringArray("run_state")]
script = ExtResource("7_spawner")
data = ExtResource("8_waves")
drop_data = ExtResource("9_drops")
run_state = NodePath("../RunState")

[node name="StatusBar" parent="." node_paths=PackedStringArray("camera", "heart", "substances", "holder", "run_state", "viewmodel_container", "crosshair", "shift_ability") instance=ExtResource("5_hud")]
camera = NodePath("../Player/Head/Camera3D")
heart = NodePath("../Player/HeartRate")
substances = NodePath("../Player/SubstanceInventory")
holder = NodePath("../Player/Head/Camera3D/WeaponHolder")
run_state = NodePath("../RunState")
viewmodel_container = NodePath("../Player/Head/Camera3D/Viewmodel/ViewLayer/ViewContainer")
crosshair = NodePath("../Hud/Crosshair")
shift_ability = NodePath("../Player/ShiftAbility")

[node name="AbilityLook" type="CanvasLayer" parent="." node_paths=PackedStringArray("shift_ability", "heart", "camera", "hud")]
script = ExtResource("20_look")
data = ExtResource("21_lookdata")
shift_ability = NodePath("../Player/ShiftAbility")
heart = NodePath("../Player/HeartRate")
camera = NodePath("../Player/Head/Camera3D")
hud = NodePath("../StatusBar")

[node name="HeartRateScreen" type="CanvasLayer" parent="." node_paths=PackedStringArray("heart", "camera", "hud", "ability_look")]
script = ExtResource("22_hrs")
data = ExtResource("23_hrsdata")
heart = NodePath("../Player/HeartRate")
camera = NodePath("../Player/Head/Camera3D")
hud = NodePath("../StatusBar")
ability_look = NodePath("../AbilityLook")

[node name="Hud" type="CanvasLayer" parent="."]
layer = 3

[node name="Crosshair" parent="Hud" node_paths=PackedStringArray("gun_feel") instance=ExtResource("99_cross")]
anchor_top = 0.4
anchor_bottom = 0.4
gun_feel = NodePath("../../Player/Head/Camera3D/GunFeel")

[node name="HitArcs" type="Control" parent="Hud" node_paths=PackedStringArray("player", "camera", "heart", "crosshair")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("97_arcs")
data = ExtResource("95_arcsdata")
player = NodePath("../../Player")
camera = NodePath("../../Player/Head/Camera3D")
heart = NodePath("../../Player/HeartRate")
crosshair = NodePath("../Crosshair")

[node name="DangerCountdown" type="Label" parent="Hud" node_paths=PackedStringArray("hud", "heart", "crosshair")]
layout_mode = 0
script = ExtResource("96_cdl")
data = ExtResource("95_arcsdata")
hud = NodePath("../../StatusBar")
heart = NodePath("../../Player/HeartRate")
crosshair = NodePath("../Crosshair")

; Tip skip vs restart: RunEndScreen ignores restart input in the frame show_results() ran, so the
; Enter or click that skips the tip never restarts, whatever the node order below.
[node name="RunEndScreen" parent="." node_paths=PackedStringArray("run_state", "screen_fade") instance=ExtResource("10_runend")]
run_state = NodePath("../RunState")
screen_fade = NodePath("../ScreenFade")

[node name="ScreenFade" parent="." instance=ExtResource("30_fade")]

[node name="DeathTip" type="CanvasLayer" parent="."]
process_mode = 3
layer = 25
script = ExtResource("32_tip")
data = ExtResource("34_flowdata")
tips = ExtResource("35_tips")

[node name="DeathCollapse" type="Node" parent="." node_paths=PackedStringArray("player", "camera", "viewmodel")]
script = ExtResource("31_col")
data = ExtResource("34_flowdata")
player = NodePath("../Player")
camera = NodePath("../Player/Head/Camera3D")
viewmodel = NodePath("../Player/Head/Camera3D/Viewmodel")

[node name="RunFlow" type="Node" parent="." node_paths=PackedStringArray("run_end_screen", "collapse", "fade", "tip", "crosshair")]
script = ExtResource("33_flow")
data = ExtResource("34_flowdata")
run_end_screen = NodePath("../RunEndScreen")
collapse = NodePath("../DeathCollapse")
fade = NodePath("../ScreenFade")
tip = NodePath("../DeathTip")
crosshair = NodePath("../Hud/Crosshair")
